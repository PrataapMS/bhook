{
  "name": "bhook",
  "private": true,
  "version": "0.1.0",
  "description": "Phone-first PWA that finds nearby restaurants, ranks them by what reviewers say, and tells you what to order.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PrataapMS/bhook.git"
  },
  "bugs": "https://github.com/PrataapMS/bhook/issues",
  "homepage": "https://github.com/PrataapMS/bhook#readme",
  "keywords": [
    "pwa",
    "restaurants",
    "google-places",
    "llm",
    "netlify",
    "react"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "netlify dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:keys": "node --env-file-if-exists=.env scripts/check-keys.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@netlify/functions": "^6.1.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "netlify-cli": "^27.17.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
