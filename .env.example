# Copy to .env. Any key left empty switches that service to demo data,
# so the app runs locally before you have a single account.

# Google Places API (New) key — server-side only, never exposed to the browser
GOOGLE_PLACES_API_KEY=

# OpenRouter key — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Default model for review summaries (any OpenRouter slug)
OPENROUTER_MODEL_REVIEWS=anthropic/claude-haiku-4.5

# Models the in-app picker may switch to. The server rejects anything not listed.
OPENROUTER_ALLOWED_MODELS=anthropic/claude-haiku-4.5,openai/gpt-5-mini,google/gemini-3.8-flash,deepseek/deepseek-v4.1-flash

# Force demo data for both services even when keys are set (true/false)
USE_MOCKS=false
